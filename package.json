{
  "name": "navy-blender-vtuber",
  "private": true,
  "version": "0.1.0",
  "description": "Personal camera-tracked 3D navy-jacket avatar for macOS",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "postinstall": "node scripts/sync-mediapipe-wasm.mjs && install-electron",
    "dev": "concurrently -k \"vite --port 5187 --strictPort\" \"node scripts/run-electron.mjs VITE_DEV_SERVER=http://localhost:5187\"",
    "web": "vite --port 5187 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "start": "npm run build && electron .",
    "shot": "node scripts/screenshot.mjs",
    "smoke": "node scripts/smoke-tracking.mjs",
    "e2e": "node scripts/e2e/run.mjs",
    "bench": "node scripts/bench-tracking.mjs",
    "smoke:electron": "npm run build && node scripts/run-electron.mjs NAVY_SMOKE_SHOT=shots/electron.png",
    "pack": "node scripts/pack-mac.mjs --standalone",
    "app": "node scripts/pack-mac.mjs && open 'release/Navy Blender VTuber.app'",
    "test": "node --test scripts/test-camera.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@pixiv/three-vrm": "^3.5.5",
    "@types/three": "0.185.4",
    "concurrently": "^10.0.3",
    "electron": "^43.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
